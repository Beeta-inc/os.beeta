#!/usr/bin/python3
# -*- coding: utf-8 -*-
# Beeta Desktop Environment
# Copyright (C) 2023-2026 Beeta Technologies Inc.
# Licensed under GNU General Public License v3.0

"""Beeta Theme Daemon (beeta-themed).

This daemon runs in the background and listens for configuration changes
or system events (time of day, weather, battery). When Adaptive Nature™
requires a color shift, this daemon:
1. Regenerates the system-wide GTK4 and GTK3 CSS files by replacing [ADAPTIVE] tokens.
2. Informs running GTK apps to reload the theme.
3. Updates Wayfire's blur settings if Adaptive Motion™ tier changes.
"""

import os
import sys
import time
import signal
import subprocess
from pathlib import Path

# Add shell config to path — handle both installed and development layouts
_script_dir = Path(__file__).resolve().parent
_dev_shell = _script_dir.parent.parent / 'beeta-shell'
_installed_shell = Path('/usr/lib/beeta-shell')

if _dev_shell.exists() and (_dev_shell / 'src' / 'config.py').exists():
    # Development mode: running from source tree
    sys.path.insert(0, str(_dev_shell))
elif _installed_shell.exists():
    # Installed mode: beeta-shell is at /usr/lib/beeta-shell
    sys.path.insert(0, str(_installed_shell))
else:
    print("[beeta-themed] Error: Cannot find beeta-shell modules.", file=sys.stderr)
    sys.exit(1)

from src.config import BeetaConfig
from src.adaptive_nature import AdaptiveNature
from src.adaptive_motion import AdaptiveMotion

_RUNNING = True


class ThemeDaemon:
    def __init__(self):
        self.config = BeetaConfig()
        self.nature = AdaptiveNature(self.config)
        self.motion = AdaptiveMotion(self.config)
        
        # Determine theme paths
        self.local_theme_dir = Path(os.environ.get(
            'XDG_DATA_HOME',
            str(Path.home() / '.local' / 'share')
        )) / 'themes' / 'BeetaGlass'
        self.system_theme_dir = Path('/usr/share/themes/BeetaGlass')
        
        self.theme_dir = (
            self.local_theme_dir
            if os.access(self.local_theme_dir.parent, os.W_OK)
            else self.system_theme_dir
        )
        
        self.gtk4_template = self._load_template('gtk-4.0/gtk.css.template', self.theme_dir)
        self.gtk3_template = self._load_template('gtk-3.0/gtk.css.template', self.theme_dir)
        
        self.last_state = None
        self.last_tier = None
        
        self.wallpaper_process = None
        self.last_wallpaper_config = None

    def _load_template(self, rel_path: str, theme_dir: Path) -> str:
        """Load template from theme dir, fallback to source tree."""
        # Check installed theme
        installed_path = theme_dir / rel_path
        if installed_path.exists():
            return installed_path.read_text()
            
        # Check source tree (for dev/testing)
        src_path = Path(__file__).resolve().parent.parent / rel_path
        if src_path.exists():
            return src_path.read_text()
            
        # If neither template exists, but the target css exists, use it as template
        css_path = Path(__file__).resolve().parent.parent / rel_path.replace('.template', '')
        if css_path.exists():
            print(f"Warning: template {rel_path} not found. Using current {css_path.name} as template.")
            return css_path.read_text()
            
        return ""

    def _generate_css(self, template: str, is_gtk4: bool) -> str:
        """Replace tokens in the CSS template using current engine state."""
        if not template:
            return ""
        
        # Read current state from the actual engine APIs
        accent = self.nature.accent_color or 'rgba(94, 231, 255, 1.0)'
        glass_bg = self.nature.glass_bg or 'rgba(12, 14, 32, 0.75)'
        glass_border = self.nature.glass_border or 'rgba(255, 255, 255, 0.12)'
        ambient = self.nature.ambient_tint or 'rgba(94, 180, 255, 0.03)'
        
        # Motion duration from the string-based tier
        tier = self.motion.tier  # 'power-saver', 'balanced', 'performance'
        durations = {
            'power-saver': '150ms',
            'balanced': '300ms',
            'performance': '400ms',
        }
        motion_dur = durations.get(tier, '300ms')

        # Build replacements dict
        replacements = {
            'beeta_accent': accent,
            'beeta_accent_dim': accent.replace('1.000)', '0.500)'),
            'beeta_accent_bg': accent.replace('1.000)', '0.080)'),
            'beeta_glass': glass_bg,
            'beeta_glass_border': glass_border,
            'beeta_ambient': ambient,
            '_motion_dur': motion_dur,
        }

        out_lines = []
        for line in template.splitlines():
            if '@define-color' in line:
                matched = False
                for token, value in replacements.items():
                    if f'@define-color {token} ' in line or f'@define-color {token}\t' in line:
                        parts = line.split(token, 1)
                        if len(parts) == 2:
                            prefix = f"{parts[0]}{token}"
                            out_lines.append(f"{prefix.ljust(35)} {value};")
                            matched = True
                            break
                if not matched:
                    out_lines.append(line)
            else:
                out_lines.append(line)

        return '\n'.join(out_lines)

    def update_theme(self) -> None:
        """Regenerate theme files and reload apps."""
        # Force the nature engine to recalculate its cached properties
        self.nature.update_theme()
        
        # Read current values
        accent = self.nature.accent_color or ''
        glass = self.nature.glass_bg or ''
        tier = self.motion.tier

        # Only update if something actually changed
        state_key = (accent, glass, tier)
        if state_key == self.last_state:
            return
            
        self.last_state = state_key
        
        print(f"[beeta-themed] Theme update triggered. Tier: {tier}")

        # Ensure local dir exists (so we can write without sudo)
        gtk4_dir = self.local_theme_dir / 'gtk-4.0'
        gtk3_dir = self.local_theme_dir / 'gtk-3.0'
        gtk4_dir.mkdir(parents=True, exist_ok=True)
        gtk3_dir.mkdir(parents=True, exist_ok=True)
        
        # Write GTK4
        gtk4_css = self._generate_css(self.gtk4_template, True)
        if gtk4_css:
            (gtk4_dir / 'gtk.css').write_text(gtk4_css)
            
        # Write GTK3
        gtk3_css = self._generate_css(self.gtk3_template, False)
        if gtk3_css:
            (gtk3_dir / 'gtk.css').write_text(gtk3_css)
            
        # Notify Wayfire to update blur radius
        self._update_wayfire_blur(tier)
        
        # Force apps to reload CSS by toggling the GTK theme
        try:
            subprocess.run(
                ['gsettings', 'set', 'org.gnome.desktop.interface', 'gtk-theme', 'Adwaita'],
                check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            )
            subprocess.run(
                ['gsettings', 'set', 'org.gnome.desktop.interface', 'gtk-theme', 'BeetaGlass'],
                check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            )
        except Exception:
            pass

    def _update_wayfire_blur(self, tier: str) -> None:
        """Update Wayfire's blur radius based on motion tier."""
        radius_map = {
            'power-saver': 8,
            'balanced': 20,
            'performance': 28,
        }
        radius = radius_map.get(tier, 20)
        
        try:
            from wayfire.ipc import WayfireSocket
            sock = WayfireSocket()
            msg = {
                "method": "core/set_config_option",
                "data": {
                    "option": "blur/kawase_offset",
                    "value": str(radius)
                }
            }
            sock.send_json(msg)
        except Exception:
            # wayfire-ipc might not be available or Wayfire not running
            pass

    def _manage_wallpaper(self) -> None:
        """Manage live wallpaper using mpvpaper."""
        live_enabled = self.config.get_bool('Desktop', 'live_wallpaper', False)
        wallpaper_path = self.config.get('Desktop', 'live_wallpaper_path', '')

        current_config = (live_enabled, wallpaper_path)
        if current_config == self.last_wallpaper_config:
            return
            
        self.last_wallpaper_config = current_config
        
        # Kill existing wallpaper process
        if self.wallpaper_process:
            try:
                self.wallpaper_process.terminate()
                self.wallpaper_process.wait(timeout=2)
            except Exception:
                pass
            self.wallpaper_process = None
            
        if live_enabled and wallpaper_path and Path(wallpaper_path).exists():
            print(f"[beeta-themed] Starting live wallpaper: {wallpaper_path}")
            try:
                self.wallpaper_process = subprocess.Popen(
                    ['mpvpaper', '-o', 'loop', '*', wallpaper_path],
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL
                )
            except FileNotFoundError:
                print("[beeta-themed] Warning: mpvpaper not installed. Cannot set live background.")

    def run(self) -> None:
        """Main loop."""
        print("[beeta-themed] Starting theme daemon...")
        
        # Initial apply
        self.update_theme()
        
        while _RUNNING:
            time.sleep(10)
            if not _RUNNING:
                break
            
            self.update_theme()
            self._manage_wallpaper()


def signal_handler(sig, frame):
    global _RUNNING
    print("\n[beeta-themed] Shutting down...")
    _RUNNING = False


def main():
    signal.signal(signal.SIGINT, signal_handler)
    signal.signal(signal.SIGTERM, signal_handler)
    
    daemon = ThemeDaemon()
    daemon.run()


if __name__ == '__main__':
    main()
