[General]
author=Beeta Technologies Inc.
comment=Beeta OS glass theme for Qt/KDE applications via Kvantum
x11drag=menubar_and_primary_toolbar
alt_mnemonic=true
left_tabs=true
joined_inactive_tabs=true
scroll_arrows=false
scrollbar_in_view=false
transient_scrollbar=true
transient_grove=true
animate_states=true
dialog_button_layout=2
combo_as_lineedit=true
combo_menu=true
submenu_overlap=0
submenu_delay=250
tooltip_delay=300
button_contents_shift=false
center_toolbar_handle=true
spread_progressbar=true
spread_header=true
merge_menubar_with_toolbar=true
small_icon_size=16
large_icon_size=32
scroll_min_extent=36
slider_width=20
slider_handle_width=20
slider_handle_length=20
check_size=20
textless_progressbar=false
progressbar_thickness=6

[GeneralColors]
window.color=#080a18
base.color=#0e1024
alt.base.color=#12142d
button.color=rgba(238,241,255,0.06)
light.color=rgba(255,255,255,0.08)
mid.light.color=rgba(255,255,255,0.04)
dark.color=#050612
mid.color=#0e1024
highlight.color=#5ee7ff
inactive.highlight.color=rgba(94,231,255,0.5)
text.color=#eef1ff
window.text.color=#eef1ff
button.text.color=#eef1ff
disabled.text.color=rgba(238,241,255,0.35)
tooltip.text.color=#eef1ff
highlight.text.color=#080a18
link.color=#5ee7ff
link.visited.color=#9b6cff
progress.indicator.text.color=#080a18

[Hacks]
transparent_dolphin_view=true
transparent_pcmanfm_sidepane=true
transparent_ktitle_label=true
blur_translucent=true
kcapacitybar_as_progressbar=true
respect_darkness=true
force_size_grip=true
normal_default_pushbutton=true
iconless_pushbutton=false
iconless_menu=false
disabled_icon_opacity=80
lxqtmainmenu_iconsize=22

[PanelButtonCommand]
frame=true
frame.element=button
frame.top=3
frame.bottom=3
frame.left=5
frame.right=5
interior=true
interior.element=button
indicator_size=20
text.normal.color=#eef1ff
text.focus.color=#5ee7ff
text.press.color=#eef1ff
text.toggle.color=#5ee7ff

[PanelButtonTool]
inherits=PanelButtonCommand

[Dock]
inherits=PanelButtonCommand

[DockTitle]
text.normal.color=#eef1ff
text.focus.color=#5ee7ff

[IndicatorSpinBox]
inherits=PanelButtonCommand

[RadioButton]
inherits=PanelButtonCommand
frame.element=radio

[CheckBox]
inherits=PanelButtonCommand
frame.element=checkbox

[GenericFrame]
frame=true
frame.element=common
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
interior=false

[LineEdit]
inherits=PanelButtonCommand
frame.element=lineedit
interior.element=lineedit

[DropDownButton]
inherits=PanelButtonCommand

[ToolboxTab]
inherits=PanelButtonCommand

[Tab]
inherits=PanelButtonCommand
frame.element=tab
interior.element=tab
text.normal.color=rgba(238,241,255,0.65)
text.focus.color=#5ee7ff
text.toggle.color=#5ee7ff
frame.top=4
frame.bottom=4
frame.left=8
frame.right=8

[TabFrame]
inherits=GenericFrame
frame.element=tabframe
interior=true
interior.element=tabframe

[HeaderSection]
inherits=PanelButtonCommand
frame.element=header
interior.element=header

[GroupBox]
inherits=GenericFrame
frame.element=group

[TabBarFrame]
inherits=GenericFrame
frame.element=tabbarframe

[SizeGrip]
indicator.element=resize-grip

[Toolbar]
inherits=PanelButtonCommand
frame=false
interior=false

[Scrollbar]
inherits=PanelButtonCommand
indicator.element=arrow
indicator_size=0

[ScrollbarGroove]
inherits=GenericFrame
frame=false
interior=true
interior.element=scrollbargroove

[ScrollbarSlider]
inherits=PanelButtonCommand
frame.element=scrollbarslider
interior=false
frame.top=5
frame.bottom=5
frame.left=5
frame.right=5

[Progressbar]
inherits=GenericFrame
frame.element=progress
interior=true
interior.element=progress
text.normal.color=#080a18
text.focus.color=#080a18

[ProgressbarContents]
inherits=GenericFrame
frame=false
interior=true
interior.element=progress-pattern

[ItemView]
inherits=PanelButtonCommand
frame=false
interior=false
text.normal.color=#eef1ff
text.focus.color=#eef1ff
text.press.color=#eef1ff
text.toggle.color=#eef1ff

[Menu]
inherits=PanelButtonCommand
frame.element=menu
interior.element=menu
text.normal.color=#eef1ff

[MenuItem]
inherits=PanelButtonCommand
frame.element=menuitem
interior.element=menuitem
text.normal.color=#eef1ff
text.focus.color=#eef1ff

[MenuBarItem]
inherits=PanelButtonCommand
frame.element=menubaritem
interior.element=menubaritem

[ComboBox]
inherits=PanelButtonCommand

[ToolTip]
inherits=GenericFrame
frame.element=tooltip
interior=true
interior.element=tooltip

[Window]
interior=true
interior.element=window
