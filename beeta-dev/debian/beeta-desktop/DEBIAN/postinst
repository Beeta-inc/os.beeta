#!/bin/bash
# Beeta Desktop — Post-installation script
set -e

case "$1" in
    configure)
        # Enable the Beeta Desktop systemd service
        if command -v systemctl &>/dev/null; then
            echo "[beeta-desktop] Enabling beeta-desktop.service..."
            systemctl daemon-reload

            # Don't auto-disable other display managers here.
            # Let the user/installer handle that explicitly.
            echo "[beeta-desktop] To use Beeta as your desktop environment:"
            echo "  sudo systemctl disable gdm.service    # (if using GDM)"
            echo "  sudo systemctl enable beeta-desktop.service"
            echo "  sudo reboot"
            echo ""
            echo "Or select 'Beeta Desktop' from your display manager login screen."
        fi

        # Set executable permissions
        chmod +x /usr/bin/beeta-session 2>/dev/null || true
        chmod +x /usr/bin/beeta-shell 2>/dev/null || true
        ;;
esac

# Automatically added by dh_installsystemd/13.31ubuntu1
if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ] ; then
	# The following line should be removed in trixie or trixie+1
	deb-systemd-helper unmask 'beeta-desktop.service' >/dev/null || true

	# was-enabled defaults to true, so new installations run enable.
	if deb-systemd-helper --quiet was-enabled 'beeta-desktop.service'; then
		# Enables the unit on first installation, creates new
		# symlinks on upgrades if the unit file has changed.
		deb-systemd-helper enable 'beeta-desktop.service' >/dev/null || true
	else
		# Update the statefile to add new symlinks (if any), which need to be
		# cleaned up on purge. Also remove old symlinks.
		deb-systemd-helper update-state 'beeta-desktop.service' >/dev/null || true
	fi
fi
# End automatically added section
# Automatically added by dh_installsystemd/13.31ubuntu1
if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ] ; then
	if [ -d /run/systemd/system ]; then
		systemctl --system daemon-reload >/dev/null || true
		if [ -n "$2" ]; then
			_dh_action=restart
		else
			_dh_action=start
		fi
		deb-systemd-invoke $_dh_action 'beeta-desktop.service' >/dev/null || true
	fi
fi
# End automatically added section

exit 0
