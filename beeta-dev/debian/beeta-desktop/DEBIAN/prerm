#!/bin/bash
# Beeta Desktop — Pre-removal script
set -e

case "$1" in
    remove|purge)
        # Stop and disable the service before removal
        if command -v systemctl &>/dev/null; then
            echo "[beeta-desktop] Stopping beeta-desktop.service..."
            systemctl stop beeta-desktop.service 2>/dev/null || true
            systemctl disable beeta-desktop.service 2>/dev/null || true
            systemctl daemon-reload
        fi
        ;;
esac

# Automatically added by dh_installsystemd/13.31ubuntu1
if [ -z "$DPKG_ROOT" ] && [ "$1" = remove ] && [ -d /run/systemd/system ] ; then
	deb-systemd-invoke stop 'beeta-desktop.service' >/dev/null || true
fi
# End automatically added section

exit 0
